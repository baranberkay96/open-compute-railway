#!/usr/bin/env bash
# Print the Caddyfile that fronts ocd on $PORT. Written for this template.
#
# ocd 0.4.0 routes a Worker only by the Host "{worker}.{instance-id}.localhost"
# on its own listener (managed Gateway aside, which needs public TCP 443 and
# DNS on port 53 and cannot run on Railway). Railway sends every domain of the
# service to one port, so Caddy maps public requests to those Worker origins:
#
#   1. /health/live, /health/ready            -> ocd (Railway healthcheck)
#   2. Host in OC_HOST_ROUTES (host=worker)   -> that Worker, full path
#   3. Host {worker}.{OC_WORKERS_DOMAIN}      -> that Worker, full path
#   4. /w/{worker}/... (OC_PATH_ROUTES=true)  -> that Worker, prefix stripped
#   5. everything else                        -> ocd control plane: /client/v4
#      API, /operator Dashboard, Git and registry paths (tokens required)
#
# ocd serves a few operator endpoints only for loopback Host names (Dashboard
# session discovery); those get Host 127.0.0.1:8787. Other control requests
# keep the public host name, so ocd's same-origin check on /operator/session
# compares the browser's Origin with the real host.
#
# Inputs: PORT, OC_INSTANCE_ID, OC_PATH_ROUTES, OC_WORKERS_DOMAIN, OC_HOST_ROUTES.
set -Eeuo pipefail
set -f  # no pathname expansion while splitting OC_HOST_ROUTES
# shellcheck source=common.sh
. /usr/local/lib/oc-railway/common.sh

port=${PORT:?PORT is required}
id=${OC_INSTANCE_ID:?OC_INSTANCE_ID is required}
path_routes=$(lower "${OC_PATH_ROUTES:-true}")
workers_domain=$(lower "${OC_WORKERS_DOMAIN:-}")
host_routes=$(lower "${OC_HOST_ROUTES:-}")

[[ $port =~ ^[0-9]{4,5}$ ]] || die "PORT must be a number from 1024 to 65535"
[[ $id =~ ^[0-9a-f]{32}$ ]] || die "OC_INSTANCE_ID must be 32 lowercase hex characters"
worker_label='[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?'

proxy_block() {
  # $1 = Host header ocd should see. Indented for a handle block.
  printf '\t\t\treverse_proxy %s {\n' "$OC_LISTEN"
  printf '\t\t\t\theader_up Host %s\n' "$1"
  # open-compute 0.4 strips every X-Forwarded-* header before a Worker sees the
  # request, so the public origin and client IP also travel as X-Public-*.
  printf '\t\t\t\theader_up X-Public-Host {http.request.host}\n'
  printf '\t\t\t\theader_up X-Public-Proto {http.request.header.X-Forwarded-Proto}\n'
  printf '\t\t\t\theader_up X-Public-Client-IP {client_ip}\n'
  printf '\t\t\t\tflush_interval -1\n'
  printf '\t\t\t}\n'
}

cat <<EOF
# Generated by render-caddyfile at container start; do not edit.
{
	admin off
	persist_config off
	auto_https off
	grace_period 15s
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
		client_ip_headers X-Forwarded-For X-Real-IP
	}
	log {
		output stderr
		format json
		level INFO
	}
}

:${port} {
	route {
		@oc_health path /health/live /health/ready
		handle @oc_health {
EOF
proxy_block "$OC_LISTEN"
printf '\t\t}\n'

n=0
for pair in $(printf '%s' "$host_routes" | tr ',;\n\t' '    '); do
  host=${pair%%=*}
  worker=${pair#*=}
  [[ $pair == *=* && $host =~ $OC_HOST_RE && $worker =~ $OC_WORKER_RE ]] \
    || die "OC_HOST_ROUTES entry '$pair' must look like app.example.com=worker-name"
  printf '\n\t\t@oc_host_%d host %s\n\t\thandle @oc_host_%d {\n' "$n" "$host" "$n"
  proxy_block "$worker.$id.localhost"
  printf '\t\t}\n'
  n=$((n + 1))
done

if [ -n "$workers_domain" ]; then
  [[ $workers_domain =~ $OC_HOST_RE ]] || die "OC_WORKERS_DOMAIN must be a domain name such as workers.example.com"
  escaped=${workers_domain//./\\.}
  printf '\n\t\t@oc_wildcard header_regexp ocwild Host ^(%s)\\.%s(?::[0-9]+)?$\n' "$worker_label" "$escaped"
  printf '\t\thandle @oc_wildcard {\n'
  proxy_block "{re.ocwild.1}.$id.localhost"
  printf '\t\t}\n'
fi

case "$path_routes" in
  true)
    printf '\n\t\t@oc_path_bare path_regexp ocbare ^/w/(%s)$\n' "$worker_label"
    printf '\t\thandle @oc_path_bare {\n\t\t\tredir {path}/{?query} 308\n\t\t}\n'
    printf '\n\t\t@oc_path path_regexp ocpath ^/w/(%s)/\n' "$worker_label"
    printf '\t\thandle @oc_path {\n'
    printf '\t\t\turi strip_prefix /w/{re.ocpath.1}\n'
    printf '\t\t\trequest_header X-Public-Prefix /w/{re.ocpath.1}\n'
    proxy_block "{re.ocpath.1}.$id.localhost"
    printf '\t\t}\n'
    ;;
  false) ;;
  *) die "OC_PATH_ROUTES must be true or false" ;;
esac

cat <<EOF

		@oc_loopback_only path /operator/api /operator/api/* /client/v4/accounts /client/v4/memberships
		handle @oc_loopback_only {
EOF
proxy_block "$OC_LISTEN"
cat <<EOF
		}

		@oc_root path /
		handle @oc_root {
			redir * /operator/ 302
		}

		handle {
EOF
proxy_block "{http.request.host}"
cat <<EOF
		}
	}
}
EOF
