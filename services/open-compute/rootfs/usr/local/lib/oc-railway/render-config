#!/usr/bin/env bash
# Render the instance configuration from Railway variables at every start:
# the three role token files and compute.toml. Runs as uid 65532 after the
# entrypoint has validated every input (see oc-railway-entrypoint).
#
# Inputs (environment): OPEN_COMPUTE_{ADMIN,DEPLOYER,READ_ONLY}_TOKEN,
# OC_PUBLIC_ORIGIN, OC_DASHBOARD, OC_STORAGE_BACKEND, OC_S3_* (s3 only),
# OC_EXTRA_CONFIG, and the disk budget computed by the entrypoint:
# OC_R_DATA_SOFT, OC_R_DATA_HARD, OC_R_CACHE_MAX, OC_R_CACHE_ARTIFACT, OC_R_OBS_DB.
set -Eeuo pipefail
# shellcheck source=common.sh
. /usr/local/lib/oc-railway/common.sh

umask 077
[ "$(id -u)" = "$OC_UID" ] || die "render-config must run as uid $OC_UID"
[ -d "$OC_DATA/keys" ] || die "missing $OC_DATA/keys; the instance was not set up" 1

# Tokens are references in the config; the files are rewritten from the
# Railway variables at every start, so changing a variable rotates the token.
write_secret_file "$OC_ROOT/keys/admin.token" "$OPEN_COMPUTE_ADMIN_TOKEN"
write_secret_file "$OC_DATA/keys/deployer.token" "$OPEN_COMPUTE_DEPLOYER_TOKEN"
write_secret_file "$OC_DATA/keys/read-only.token" "$OPEN_COMPUTE_READ_ONLY_TOKEN"

tmp=$(mktemp "$OC_INSTANCE_DIR/.compute.toml.XXXXXX")
{
  printf '# Generated by the Railway wrapper at every start from service variables.\n'
  printf '# Edits here are overwritten; use the variables (OC_EXTRA_CONFIG for extra sections).\n\n'
  printf '[instance]\nname = "default"\n\n'
  printf '[auth]\ndeployer_auth = { file = '; toml_string "$OC_DATA/keys/deployer.token"
  printf ' }\nread_only_auth = { file = '; toml_string "$OC_DATA/keys/read-only.token"
  printf ' }\n\n'
  printf '[data]\npath = '; toml_string "$OC_DATA"
  printf '\nmaster_key_file = '; toml_string "$OC_DATA/keys/master.key"
  printf '\nfree_space_soft_bytes = %s\nfree_space_hard_bytes = %s\n\n' "$OC_R_DATA_SOFT" "$OC_R_DATA_HARD"
  printf '[cache]\nmax_bytes = %s\nmax_artifact_bytes = %s\n\n' "$OC_R_CACHE_MAX" "$OC_R_CACHE_ARTIFACT"
  printf '[dashboard]\nenabled = %s\n\n' "$OC_DASHBOARD"
  printf '[artifacts]\npublic_origin = '; toml_string "$OC_PUBLIC_ORIGIN"
  printf '\n\n[observability]\nexternal_control_origin = '; toml_string "$OC_PUBLIC_ORIGIN"
  printf '\nmax_database_bytes = %s\n\n' "$OC_R_OBS_DB"
  printf '[storage]\n'
  if [ "$OC_STORAGE_BACKEND" = s3 ]; then
    printf 'backend = "s3"\nendpoint = '; toml_string "$OC_S3_ENDPOINT"
    printf '\nregion = '; toml_string "$OC_S3_REGION"
    printf '\nbucket = '; toml_string "$OC_S3_BUCKET"
    printf '\nforce_path_style = %s\nprefix = ' "$OC_S3_FORCE_PATH_STYLE"; toml_string "$OC_S3_PREFIX"
    printf '\nr2_prefix = '; toml_string "$OC_S3_R2_PREFIX"
    printf '\naccess_key_id_env = "OC_S3_ACCESS_KEY_ID"\nsecret_access_key_env = "OC_S3_SECRET_ACCESS_KEY"\n'
  else
    printf 'backend = "local"\nprefix = "system/"\nr2_prefix = "tenant/r2/"\n'
    printf 'free_space_soft_bytes = %s\nfree_space_hard_bytes = %s\n' "$OC_R_DATA_SOFT" "$OC_R_DATA_HARD"
  fi
  if [ -n "${OC_EXTRA_CONFIG:-}" ]; then
    printf '\n# --- OC_EXTRA_CONFIG ---\n%s\n' "$OC_EXTRA_CONFIG"
  fi
} > "$tmp"
chmod 0600 "$tmp"
install_if_changed "$tmp" "$OC_CONFIG"
